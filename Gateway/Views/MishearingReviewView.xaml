<UserControl x:Class="Translation.Gateway.Views.MishearingReviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="900">
    <Grid Margin="16,14,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 標題與提示 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="聽錯字修正" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Whisper 把詞彙卡名詞聽錯的寫法。核准後會在前處理修正原文；駁回會直接刪除該筆。"
                       Style="{StaticResource Hint}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- 篩選與搜尋 -->
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBox Width="220" HorizontalAlignment="Right"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                     ToolTip="搜尋卡名、名詞或聽錯寫法（不分大小寫、全半形與平假名片假名互通）"/>
            <ComboBox Width="96" HorizontalAlignment="Right" Margin="0,0,8,0"
                      ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding StatusFilter}"
                      ToolTip="依審核狀態篩選"/>
            <TextBlock Text="{Binding ErrorText}" Style="{StaticResource Hint}" VerticalAlignment="Center"
                       Foreground="{StaticResource ErrorTextBrush}" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <!-- 中間：DataGrid 與空狀態提示 -->
        <Grid Grid.Row="2">
            <DataGrid ItemsSource="{Binding Items}"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserSortColumns="False" CanUserReorderColumns="False"
                      IsReadOnly="True"
                      ToolTip="勾選後按「核准」或「駁回（刪除）」批次處理">
                <DataGrid.Columns>
                    <!-- 範本欄的 CheckBox 單擊即切換，不必先選取列；標頭核選全選／全不選 -->
                    <DataGridTemplateColumn Header="選" Width="34">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                          IsChecked="{Binding DataContext.AllVisibleSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          ToolTip="全選／全不選目前顯示的修正"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="詞彙卡" Width="110" Binding="{Binding CardName}"/>
                    <DataGridTextColumn Header="正確名詞" Width="110" Binding="{Binding TermSource}"/>
                    <DataGridTextColumn Header="譯名" Width="110" Binding="{Binding TermTarget}"/>
                    <DataGridTextColumn Header="聽錯寫法" Width="110" Binding="{Binding Wrong}"/>
                    <DataGridTextColumn Header="證據" Width="*" Binding="{Binding Evidence}">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="4,3"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="次數" Width="46" Binding="{Binding Occurrences}"/>
                    <DataGridTemplateColumn Header="狀態" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusText}" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource WarnTextBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Fix.Status}" Value="Approved">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="更新時間" Width="82" Binding="{Binding UpdatedText}"/>
                </DataGrid.Columns>
            </DataGrid>
            <!-- 空狀態：沒有資料時顯示在 DataGrid 中間 -->
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Text="目前沒有聽錯字修正。開始直播後，系統會每 5 分鐘從字幕中找出可能的聽錯字。">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasItems}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- 底部：狀態與按鈕列 -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Command="{Binding ToggleSelectAllCommand}"
                        ToolTip="全選／全不選目前顯示的修正（被篩選掉的不受影響）">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Content" Value="全選"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AllVisibleSelected}" Value="True">
                                    <Setter Property="Content" Value="全不選"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="駁回（刪除）" Margin="6,0,0,0" Command="{Binding DeleteSelectedCommand}"
                        ToolTip="刪除勾選的修正（刪除後無法復原）"/>
                <Button Content="核准" Margin="6,0,0,0" Style="{StaticResource PrimaryButton}"
                        Command="{Binding ApproveSelectedCommand}"
                        ToolTip="勾選的修正改成已核准（前處理會套用）"/>
            </StackPanel>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Hint}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</UserControl>
