<UserControl x:Class="Translation.Gateway.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:Translation.Bridge.Core.Models;assembly=Bridge.Core"
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="16,14,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 標題與即時統計 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <!-- 右側兩行：上面聽錯字探勘狀態＋立即探勘，下面翻譯即時統計（排成兩行，左邊的標題才有空間） -->
            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                <!-- 聽錯字探勘狀態膠囊；按鈕可略過間隔立刻探勘 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border CornerRadius="12" Padding="12,4" Background="#E9EEF5" VerticalAlignment="Center"
                            ToolTip="{Binding MishearingStatusToolTip}">
                        <TextBlock Text="{Binding MishearingStatusText}" FontSize="12"
                                   Foreground="{StaticResource SubTextBrush}"/>
                    </Border>
                    <Button Content="立即探勘" Margin="6,0,0,0" Padding="8,1" VerticalAlignment="Center"
                            Command="{Binding MineMishearingNowCommand}"
                            ToolTip="略過間隔與新字幕下限，馬上用時間窗內的字幕跑一次聽錯字探勘"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" Margin="0,4,0,0" CornerRadius="12" Padding="12,4"
                        ToolTip="依 Dashboard 上的字幕計算（每 10 秒更新）；P95 = 95% 的句子都在這個時間內完成">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#E9EEF5"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatsWarning}" Value="True">
                                    <Setter Property="Background" Value="#FCEFD9"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatsText}" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatsWarning}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WarnTextBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </StackPanel>
            <!-- 頁首：這場的標題（譯文大字粗體在上、日文原文小字在下）；還沒開台時只有「字幕監看」 -->
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource PageTitle}" FontWeight="Bold"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding HeaderTitle}"/>
                <TextBlock Text="{Binding HeaderSubtitle}" FontSize="16" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding HeaderSubtitle}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HeaderSubtitle}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <!-- 直播資訊與修正規則 -->
        <StackPanel Grid.Row="1">
            <Border Style="{StaticResource Card}">
                <Expander IsExpanded="{Binding StreamInfoExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="直播資訊" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="{Binding ActiveProfileText}"
                                       Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StreamInfoUpdatedText, StringFormat='　{0}'}"
                                       Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding GlossarySummaryText, StringFormat='　{0}'}"
                                       Style="{StaticResource Hint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Expander.Header>
                    <StackPanel Margin="0,8,0,2">
                        <!-- 設定檔：選既有名稱或直接輸入新名稱 -->
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock Text="設定檔" Style="{StaticResource FieldLabel}" Margin="0,0,8,0"/>
                            <ComboBox Width="200" IsEditable="True" ItemsSource="{Binding ProfileNames}"
                                      Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                                      ToolTip="選擇已存的設定檔，或輸入新名稱（例如主播名）後按「儲存」"/>
                            <Button Content="套用" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                                    Command="{Binding ApplyProfileCommand}"
                                    ToolTip="載入此設定檔的情境、角色表與兩組修正規則，並重置對話"/>
                            <Button Content="存檔" Margin="6,0,0,0" Command="{Binding SaveProfileCommand}"
                                    ToolTip="把目前的情境、角色表與修正規則存成這個名稱（同名覆寫）"/>
                            <Button Content="刪除" Margin="6,0,0,0" Command="{Binding DeleteProfileCommand}"/>
                            <TextBlock Text="{Binding ProfileMessage}" Style="{StaticResource Hint}"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </DockPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- 左欄：分頁［情境｜歌曲清單］；歌曲清單分頁只在錄影時顯示（Visibility 綁 ShowSongList） -->
                            <TabControl Grid.Column="0" SelectedIndex="{Binding InfoTabIndex, Mode=TwoWay}">
                                <TabItem Header="情境">
                                    <StackPanel>
                                        <TextBlock Text="情境（只存在設定檔，不寫回詞彙卡）"
                                                   Style="{StaticResource Hint}" Margin="0,0,0,3"/>
                                        <TextBox AcceptsReturn="True" TextWrapping="Wrap" Height="96"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Text="{Binding StreamSituation, UpdateSourceTrigger=PropertyChanged, Delay=500}"/>
                                        <WrapPanel Margin="0,4,0,0">
                                            <ItemsControl ItemsSource="{Binding MiningResultTags}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.CopyMiningTagCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"
                                                                IsEnabled="{Binding CanCopy}"
                                                                Cursor="Hand">
                                                            <Button.ToolTip>
                                                                <ToolTip ContentStringFormat="點一下複製「{0}」" Content="{Binding CopyText}"/>
                                                            </Button.ToolTip>
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Opacity" Value="0.8"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsPressed" Value="True">
                                                                            <Setter Property="Opacity" Value="0.6"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <ContentPresenter/>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                            <Border CornerRadius="3" Padding="5,1" Margin="0,1,6,1">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Background" Value="#E9EEF5"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Kind}" Value="Matched">
                                                                                <Setter Property="Background" Value="#E3F2E6"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Kind}" Value="AddedAlias">
                                                                                <Setter Property="Background" Value="#E3F2E6"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Kind}" Value="Created">
                                                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Kind}" Value="Candidate">
                                                                                <Setter Property="Background" Value="#EFEFEF"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Kind}" Value="NotFound">
                                                                                <Setter Property="Background" Value="#FCEFD9"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding Kind}" Value="Failed">
                                                                                <Setter Property="Background" Value="#F9E3E3"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding Text}" FontSize="11">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Kind}" Value="Matched">
                                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Kind}" Value="AddedAlias">
                                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessTextBrush}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Kind}" Value="Created">
                                                                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Kind}" Value="NotFound">
                                                                                    <Setter Property="Foreground" Value="{StaticResource WarnTextBrush}"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Kind}" Value="Failed">
                                                                                    <Setter Property="Foreground" Value="{StaticResource ErrorTextBrush}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Content="資料探勘" Style="{StaticResource PrimaryButton}" Padding="8,1" FontSize="11"
                                                    VerticalAlignment="Center" Margin="2,1,0,1"
                                                    IsEnabled="{Binding CanStartMining}"
                                                    ToolTip="{Binding MiningDisabledToolTip}"
                                                    Command="{Binding MineSituationCommand}"/>
                                            <TextBlock Text="{Binding MiningProgressText}" Style="{StaticResource Hint}" FontSize="11"
                                                       VerticalAlignment="Center" Margin="8,1,6,1" TextTrimming="CharacterEllipsis"
                                                       MaxWidth="260" ToolTip="{Binding MiningProgressText}"/>
                                            <Button Content="取消" Padding="8,1" FontSize="11" VerticalAlignment="Center"
                                                    Command="{Binding CancelMiningCommand}"
                                                    ToolTip="取消執行中的資料探勘">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMining}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <TextBlock Text="未設定知識庫模型：只有開台探勘會用翻譯模型執行" Style="{StaticResource Hint}" FontSize="11"
                                                       VerticalAlignment="Center" Margin="2,1,0,1"
                                                       ToolTip="手動探勘、成員探勘與排程的聽錯字探勘需要知識庫模型；開台探勘在只設定翻譯模型時會借用翻譯模型"
                                                       Visibility="{Binding ShowLorebookMissingHint, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </TabItem>
                                <TabItem Visibility="{Binding ShowSongList, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TabItem.Header>
                                        <TextBlock Text="{Binding SongList.Count, StringFormat='歌曲清單 {0}'}"/>
                                    </TabItem.Header>
                                    <DockPanel>
                                        <!-- 上方一列：來源說明（左）與貼上／清除按鈕（右） -->
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,3">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Content="清除人工章節" Padding="8,1" FontSize="11"
                                                        Command="{Binding ClearManualChaptersCommand}"
                                                        ToolTip="刪掉人工貼上的章節，改回自動抓到的（說明欄→留言セトリ）"/>
                                                <Button Content="從剪貼簿貼上" Style="{StaticResource PrimaryButton}" Padding="8,1" FontSize="11"
                                                        Margin="6,0,0,0" Command="{Binding PasteChaptersCommand}"
                                                        ToolTip="把剪貼簿的セトリ（每行 時間戳＋曲名）貼上成章節清單；找不到章節時也可以用"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding SongListSourceText}" Style="{StaticResource Hint}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                        <!-- 貼上結果等短訊息：空字串時收合 -->
                                        <TextBlock DockPanel.Dock="Top" Text="{Binding SongListMessage}" Margin="0,0,0,3"
                                                   TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SongListMessage}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- 歌曲清單：點整列讓 PotPlayer 跳轉；IsPlaying 時左側 3px 金色細線（預留透明邊線，只換顏色） -->
                                        <ListBox ItemsSource="{Binding SongList}" Height="120"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ToolTip="點一下讓 PotPlayer 跳到這首歌的開始時間">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Cursor="Hand" HorizontalContentAlignment="Stretch"
                                                            Command="{Binding DataContext.SeekToSongCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="點一下讓 PotPlayer 跳到這首歌的開始時間">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Opacity" Value="0.8"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter Property="Opacity" Value="0.6"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <ContentPresenter/>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <Border BorderThickness="3,0,0,0" Padding="4,2" Margin="0,1">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                            <Setter Property="BorderBrush" Value="#E0A800"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <StackPanel>
                                                                <DockPanel>
                                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding TimeRangeText}"
                                                                               Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                                                               VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding Translation}" FontWeight="Bold" Margin="8,0,0,0"
                                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Translation}" Value="{x:Null}">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </DockPanel>
                                                                <TextBlock Text="{Binding Title}" FontSize="11"
                                                                           Foreground="{StaticResource SubTextBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </DockPanel>
                                </TabItem>
                            </TabControl>
                            <StackPanel Grid.Column="2" x:Name="GlossaryPanel">
                                <DockPanel Margin="0,0,0,3">
                                    <Button DockPanel.Dock="Right" Content="↻" Padding="6,1" Margin="6,0,0,0"
                                            Command="{Binding ReloadGlossaryCommand}"
                                            ToolTip="重新從資料庫讀取詞彙卡"/>
                                    <TextBox DockPanel.Dock="Right" x:Name="GlossarySearchBox" Width="200"
                                             Text="{Binding GlossarySearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="用中文或日文搜尋卡名或名詞，例如 小燈、リサ、VALORANT"/>
                                    <TextBlock Text="詞彙卡" Style="{StaticResource SectionHeader}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding GlossaryStatus}" Style="{StaticResource Hint}"
                                               VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>

                                <!-- 生效清單：依「上層卡在前、子卡縮排在後」排列；雙擊整列或按 › 開抽屜編輯名詞 -->
                                <ListBox x:Name="ActiveCardsList" Height="118" ItemsSource="{Binding ActiveGlossaryCards}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ToolTip="雙擊整列（或右側 ›）開啟抽屜編輯這張卡的名詞">
                                    <ListBox.InputBindings>
                                        <!-- CommandParameter 用 ElementName 指回清單的 SelectedItem（InputBinding 不在視覺樹，RelativeSource 無效） -->
                                        <MouseBinding MouseAction="LeftDoubleClick"
                                                      Command="{Binding OpenGlossaryDrawerCommand}"
                                                      CommandParameter="{Binding SelectedItem, ElementName=ActiveCardsList}"/>
                                    </ListBox.InputBindings>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="24" Margin="0,1">
                                                <DockPanel VerticalAlignment="Center">
                                                    <Button DockPanel.Dock="Right" Content="›" Padding="6,0" Margin="4,0,2,0" FontSize="12"
                                                            Command="{Binding DataContext.OpenGlossaryDrawerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" ToolTip="編輯名詞"/>
                                                    <Button DockPanel.Dock="Right" Content="×" Padding="6,0" Margin="4,0,2,0" FontSize="12"
                                                            Command="{Binding DataContext.RemoveGlossaryCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" ToolTip="不再生效"/>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock x:Name="IndentMark" Text="└" Width="18" Foreground="{StaticResource MutedTextBrush}" Visibility="Collapsed"/>
                                                        <TextBlock x:Name="ActiveDot" Text="●" Foreground="{StaticResource SuccessTextBrush}"
                                                                   FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock x:Name="ReasonMeta" Style="{StaticResource Hint}" Margin="6,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="{}{0}・{1}">
                                                                    <Binding Path="ReasonText"/>
                                                                    <Binding Path="TermCount"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Grid>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Indent}" Value="True">
                                                    <Setter TargetName="IndentMark" Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- 臨時角色表（預設收合）：只進 prompt，不寫回詞彙卡 -->
                                <Expander IsExpanded="False" Margin="0,6,0,0">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="臨時角色表（只進 prompt，不寫回詞彙卡）" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CharacterTableLineCount, StringFormat='・{0} 行'}"
                                                       Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Expander.Header>
                                    <TextBox Style="{StaticResource RulesBox}" Height="72" Margin="0,4,0,0"
                                             Text="{Binding CharacterTable, UpdateSourceTrigger=PropertyChanged, Delay=500}"
                                             ToolTip="每行「原名=譯名（備註）」，# 開頭為註解；只進 prompt，不會寫回詞彙卡"/>
                                </Expander>

                                <!-- 搜尋結果下拉：點一列切換生效（連同上層卡），執行後清空搜尋文字並關閉 -->
                                <Popup IsOpen="{Binding IsGlossarySearchOpen}" StaysOpen="False"
                                       PlacementTarget="{Binding ElementName=GlossarySearchBox}" Placement="Bottom"
                                       Width="320" MaxHeight="260" AllowsTransparency="True">
                                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}"
                                            BorderThickness="1" CornerRadius="4">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="258">
                                            <ItemsControl ItemsSource="{Binding GlossaryResults}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.ToggleGlossaryCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Background="Transparent" BorderThickness="0"
                                                                HorizontalContentAlignment="Left" Padding="6,3"
                                                                ToolTip="點擊切換生效狀態（連同上層卡）">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="●" Foreground="{StaticResource SuccessTextBrush}" FontSize="10"
                                                                           VerticalAlignment="Center" Margin="0,0,4,0">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}"/>
                                                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </StackPanel>
                        </Grid>

                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Content="重置對話"
                                    Command="{Binding ResetConversationCommand}"
                                    ToolTip="清空模型的對話歷史（翻譯開始怪怪的、拖進度條後可以按）"/>
                            <TextBlock Text="修改情境或角色表後會自動預熱模型" Style="{StaticResource Hint}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </StackPanel>
                </Expander>
            </Border>

            <Border Style="{StaticResource Card}">
                <Expander IsExpanded="{Binding RulesExpanded, Mode=TwoWay}">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="修正規則" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="　原文修正（翻譯前）＋ 譯名修正（翻譯後）"
                                       Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Expander.Header>
                    <Grid Margin="0,8,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="原文修正（翻譯前，修正 Whisper 聽錯的日文）" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="每行「聽錯=正確」，例：ペコラ=ぺこら。# 開頭為註解"
                                       Style="{StaticResource Hint}" Margin="0,2,0,3"/>
                            <TextBox Style="{StaticResource RulesBox}" Height="96"
                                     Text="{Binding SourceReplacementRules, UpdateSourceTrigger=PropertyChanged, Delay=500}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="譯名修正（翻譯後，修正中文譯名）" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Text="每行「錯誤譯名=正確譯名」，右邊留空代表刪除。# 開頭為註解"
                                       Style="{StaticResource Hint}" Margin="0,2,0,3"/>
                            <TextBox Style="{StaticResource RulesBox}" Height="96"
                                     Text="{Binding ReplacementRules, UpdateSourceTrigger=PropertyChanged, Delay=500}"/>
                        </StackPanel>
                    </Grid>
                </Expander>
            </Border>
        </StackPanel>

        <!-- 編輯／鎖定狀態與最近操作結果 -->
        <DockPanel Grid.Row="2" Margin="2,2,2,6">
            <ToggleButton DockPanel.Dock="Right" Content="顯示 Prompt" Margin="10,0,0,0" Padding="10,1"
                          IsChecked="{Binding ShowPromptDetails}"
                          ToolTip="顯示選取字幕的 User／System Prompt 詳細內容（除錯用）"/>
            <Button DockPanel.Dock="Right" Content="{Binding PauseButtonText}" Margin="10,0,0,0" Padding="10,1"
                    Command="{Binding TogglePauseCommand}"
                    ToolTip="暫停時新字幕先暫存（翻譯照常運作），方便回頭看；按「繼續捲動」一次補上"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding ActionMessage}" FontSize="12" VerticalAlignment="Center"
                       Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="{Binding LockStatusText}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource WarnTextBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource WarnTextBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DockPanel>

        <DataGrid Grid.Row="3" x:Name="JobsGrid" ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}"
                  AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" VerticalScrollBarVisibility="Auto">
            <DataGrid.InputBindings>
                <KeyBinding Key="Delete" Command="{Binding DeleteSelectedCommand}"/>
            </DataGrid.InputBindings>
            <DataGrid.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="複製原文" Command="{Binding CopySourceCommand}"/>
                    <MenuItem Header="複製翻譯" Command="{Binding CopyTranslationCommand}"/>
                    <MenuItem Header="複製原文＋翻譯" Command="{Binding CopyBothCommand}"/>
                    <Separator/>
                    <MenuItem Header="重新翻譯這句" Command="{Binding RetranslateSelectedCommand}"/>
                    <MenuItem Header="把原文的修改加入原文修正規則" Command="{Binding AddSourceRuleFromEditCommand}"
                              ToolTip="雙擊原文修正 Whisper 聽錯後使用：之後同樣的聽錯會在翻譯前自動修正"/>
                    <MenuItem Header="刪除這句（Delete）" Command="{Binding DeleteSelectedCommand}"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <!-- 每列都預留透明的 3px 左邊線：高亮時只換顏色，內容不會左右跳動 -->
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="3,0,0,0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Source}" Value="{x:Static models:TranslationSource.Cache}">
                            <Setter Property="Background" Value="#F2F7FD"/>
                            <Setter Property="ToolTip" Value="快取命中"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Source}" Value="{x:Static models:TranslationSource.Reused}">
                            <Setter Property="Background" Value="#F2F7FD"/>
                            <Setter Property="ToolTip" Value="重複字幕，沿用上一句譯文"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Source}" Value="{x:Static models:TranslationSource.Timeout}">
                            <Setter Property="Background" Value="#FDF6EC"/>
                            <Setter Property="ToolTip" Value="逾時，已回傳原文"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Source}" Value="{x:Static models:TranslationSource.ThroughPass}">
                            <Setter Property="Background" Value="#F5F5F5"/>
                            <Setter Property="ToolTip" Value="直通模式"/>
                        </DataTrigger>
                        <!-- 錄影時 PotPlayer 目前播放到的那一句：只加左側金色細線（不改底色、不改字型，來源底色照舊） -->
                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                            <Setter Property="BorderBrush" Value="#E0A800"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="時間" Binding="{Binding Timestamp, StringFormat=\{0:HH:mm:ss\}}" Width="70"
                                    IsReadOnly="True" ElementStyle="{StaticResource MutedCell}"/>
                <!-- 單向綁定的 DataGridTextColumn 會被 DataGrid 強制視為唯讀，因此改用模板欄：顯示用 TextBlock，編輯用 OneTime 的 TextBox（值由 ViewModel 寫回） -->
                <DataGridTemplateColumn Header="原文" Width="*" SortMemberPath="Current">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Current}" Margin="2,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource SubTextBrush}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Current, Mode=OneTime}" Loaded="EditBox_Loaded"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="翻譯" Width="*" SortMemberPath="TranslatedText">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding TranslatedText}" Margin="2,0" TextWrapping="Wrap" FontSize="14"
                                       Foreground="{StaticResource TextBrush}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding TranslatedText, Mode=OneTime}" Loaded="EditBox_Loaded" FontSize="14"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="總耗時" Binding="{Binding TotalLatency}" Width="58"
                                    IsReadOnly="True" ElementStyle="{StaticResource MutedCell}"/>
                <DataGridTextColumn Header="AI 耗時" Binding="{Binding ModelLatency}" Width="62"
                                    IsReadOnly="True" ElementStyle="{StaticResource MutedCell}"/>
                <DataGridTemplateColumn Header="來源" Width="48" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="12" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#999999"/>
                                        <Setter Property="Text" Value=""/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Source}" Value="{x:Static models:TranslationSource.Cache}">
                                                <Setter Property="Text" Value="快取"/>
                                                <Setter Property="Foreground" Value="#5B8BD0"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Source}" Value="{x:Static models:TranslationSource.Reused}">
                                                <Setter Property="Text" Value="沿用"/>
                                                <Setter Property="Foreground" Value="#5B8BD0"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Source}" Value="{x:Static models:TranslationSource.Timeout}">
                                                <Setter Property="Text" Value="逾時"/>
                                                <Setter Property="Foreground" Value="#C07000"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Source}" Value="{x:Static models:TranslationSource.ThroughPass}">
                                                <Setter Property="Text" Value="直通"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="處理" Binding="{Binding ProcessLatency}" Width="50"
                                    IsReadOnly="True" ElementStyle="{StaticResource MutedCell}"/>
                <DataGridTextColumn Header="tok" Binding="{Binding TotalTokens}" Width="50"
                                    IsReadOnly="True" ElementStyle="{StaticResource MutedCell}"/>
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="4" Height="8" HorizontalAlignment="Stretch" Background="Transparent"
                      ToolTip="拖曳調整上下高度">
            <GridSplitter.Style>
                <Style TargetType="GridSplitter">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowPromptDetails}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </GridSplitter.Style>
        </GridSplitter>

        <!-- 選取字幕的 prompt 詳細內容（除錯用，預設隱藏）：Row 5 = Auto 且內容 Collapsed，
             隱藏時字幕表格吃滿剩餘高度；顯示 Prompt 切換鈕在字幕表格上方的工具列最右側 -->
        <!-- Visibility 放在外層：同一元素上設 DataContext 時，其他繫結會改以 SelectedJob 為來源 -->
        <Border Grid.Row="5" MinHeight="220"
                Visibility="{Binding ShowPromptDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid DataContext="{Binding SelectedJob}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <GroupBox Header="User Prompt（送給模型的使用者訊息）" Margin="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding UserTokens, StringFormat='約 {0} tokens'}"
                                   Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                        <TextBox Text="{Binding UserPrompt, Mode=OneWay}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                 IsReadOnly="True" Background="#FAFBFC" BorderThickness="0"/>
                    </DockPanel>
                </GroupBox>

                <GroupBox Grid.Column="2" Header="System Prompt（注入情境與角色表後）" Margin="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding SystemTokens, StringFormat='約 {0} tokens'}"
                                   Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                        <TextBox Text="{Binding SystemPrompt, Mode=OneWay}" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                  IsReadOnly="True" Background="#FAFBFC" BorderThickness="0"/>
                    </DockPanel>
                </GroupBox>
            </Grid>
        </Border>

        <!-- 詞彙卡抽屜：點詞彙卡清單的列（或 › 按鈕）開啟，蓋在頁面右側編輯該卡（含上層分頁）的名詞。
             外層 Border 綁 Dashboard 的 IsGlossaryDrawerOpen；內層才把 DataContext 切到 GlossaryDrawer -->
        <Border Grid.Row="0" Grid.RowSpan="6" Panel.ZIndex="10" Width="440" HorizontalAlignment="Right"
                Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0"
                Visibility="{Binding IsGlossaryDrawerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" Opacity="0.18" Direction="180"/>
            </Border.Effect>
            <Border.InputBindings>
                <KeyBinding Key="Esc" Command="{Binding GlossaryDrawer.CloseCommand}"/>
            </Border.InputBindings>
            <Grid DataContext="{Binding GlossaryDrawer}" Margin="14,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 卡名、種類與狀態、關閉 -->
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="×" Padding="8,2" FontSize="14"
                            Command="{Binding CloseCommand}" AutomationProperties.Name="關閉" ToolTip="關閉抽屜（Esc）"/>
                    <StackPanel>
                        <TextBlock Text="{Binding CardName}" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0">
                            <Run Text="{Binding CardKindText, Mode=OneWay}"/><Run Text="・"/><Run Text="{Binding CardStatusText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>

                <!-- 分頁（本卡／上層）：圓角膠囊，選取時 AccentSoftBrush 底色 -->
                <ListBox Grid.Row="1" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                         Background="Transparent" BorderThickness="0" Margin="0,0,0,2"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" Focusable="False"
                         ToolTip="切換本卡與上層卡；未儲存的修改會保留在各分頁">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Capsule" CornerRadius="10" Padding="12,5" Margin="0,0,6,4"
                                                Background="Transparent" Cursor="Hand">
                                            <ContentPresenter TextElement.FontSize="12"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Capsule" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Capsule" Property="Background" Value="#EEF3FB"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 搜尋 -->
                <TextBox Grid.Row="2" Margin="0,0,0,6" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="搜尋這張卡的名詞（原文／譯名／別名；不分大小寫、全半形與平假名片假名互通）"/>

                <!-- 成員（團體卡分頁）：勾選＝讓成員的角色卡生效、取消＝移除；沒有角色卡的成員可一鍵探勘 -->
                <GroupBox Grid.Row="3" Header="成員（勾選＝角色卡生效）" Margin="0,0,0,6" Padding="6,4"
                          Visibility="{Binding HasMembers, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="180">
                        <ItemsControl ItemsSource="{Binding Members}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,1">
                                        <Button DockPanel.Dock="Right" Content="探勘" Padding="8,1" FontSize="11" Margin="6,0,0,0"
                                                Command="{Binding DataContext.MineMemberCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="用這個名字跑資料探勘建立角色卡，完成後自動生效">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasCard}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <CheckBox IsChecked="{Binding IsActive}" IsEnabled="{Binding HasCard}"
                                                  Content="{Binding DisplayText}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </GroupBox>

                <!-- 名詞表：直接編輯，dirty 的列淺黃底粗體 -->
                <DataGrid Grid.Row="4" ItemsSource="{Binding VisibleTerms}" SelectedItem="{Binding SelectedTerm}"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          CanUserSortColumns="False" CanUserReorderColumns="False" IsReadOnly="False"
                          ToolTip="原文、譯名、分類可直接編輯；有修改的列以粗體與淺黃底顯示">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <!-- WarnTextBrush 顏色加 0.15 不透明度（不能直接改共用筆刷） -->
                                            <SolidColorBrush Color="{Binding Color, Source={StaticResource WarnTextBrush}}" Opacity="0.15"/>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="原文" Width="*"
                                            Binding="{Binding Path=Source, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="譯名" Width="*"
                                            Binding="{Binding Path=Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTextColumn Header="分類" Width="70"
                                            Binding="{Binding Path=Category, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- 新增名詞 -->
                <Button Grid.Row="5" Content="＋ 新增名詞" HorizontalAlignment="Left" Padding="10,2" Margin="0,6,0,0"
                        Command="{Binding AddTermCommand}" ToolTip="在目前分頁的名詞清單最後面加一個新名詞"/>

                <!-- 底部：說明、狀態訊息、放棄與存檔 -->
                <DockPanel Grid.Row="6" Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Content="放棄變更" Command="{Binding DiscardCommand}"
                                ToolTip="重新載入，放棄所有未儲存的變更"/>
                        <Button Content="存檔到詞彙卡" Margin="6,0,0,0" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveCommand}"
                                ToolTip="把所有分頁的變更寫回資料庫（同一個交易）；卡片生效中時同時更新 prompt"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="{Binding FooterText}" Style="{StaticResource Hint}"/>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource Hint}"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
